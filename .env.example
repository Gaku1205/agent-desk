# agent-desk の環境変数の例。`.env.local` にコピーして、値を自分の物に書き換える。
# ここに本物の秘密は書かない（`.env.local` は git に入らない）。

# --- 必須 ---

# Auth.js の暗号化キー（`openssl rand -base64 32` で作る）
AUTH_SECRET=your-auth-secret

# GitHub OAuth App の Client ID / Client secret
AUTH_GITHUB_ID=your-oauth-client-id
AUTH_GITHUB_SECRET=your-oauth-client-secret

# ログインを許可する GitHub ユーザー名（カンマ区切り）
ALLOWED_GITHUB_LOGINS=your-github-login

# 監視するリポジトリ（owner/repo のカンマ区切り）
WATCHED_REPOS=your-name/your-repo

# 設定画面の保存先のリポジトリ（owner/repo。ふつうは agent-desk 自身）
SETTINGS_REPO=your-name/agent-desk

# --- 任意 ---

# パイプラインの GitHub App の鍵で同期を読む（README「同期の読み取りをパイプラインのAppの鍵で行う」）
# PIPELINE_APP_ID=your-app-id
# PIPELINE_APP_PRIVATE_KEY=your-app-private-key

# Webhook で変わった時だけ取り直す（README「GitHub の Webhook で…」）
# GITHUB_WEBHOOK_SECRET=your-webhook-secret
